ENVIRONMENT=development
IMAGE_TAG=local
POSTGRES_USER=docs
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=docs
DATABASE_URL=postgresql+asyncpg://docs:docs@postgres:5432/docs
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CACHE_TTL_SECONDS=900
MAX_INGESTION_ATTEMPTS=5
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
CELERY_CONCURRENCY=2
FLOWER_BIND_ADDRESS=127.0.0.1
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:replace-with-a-strong-flower-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=company-docs
JWT_AUDIENCE=company-docs-api
ACCESS_TOKEN_MINUTES=15
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=26214400
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=company_documents_hybrid_v1
RETRIEVAL_CANDIDATE_LIMIT=30
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=4
RAG_MODEL=gpt-5.6-sol
RAG_REASONING_EFFORT=low
RAG_CONTEXT_TOKENS=6000
RAG_MIN_CONFIDENCE=0.60
RAG_HYBRID_SCORE_THRESHOLD=0.20
RAG_SEMANTIC_SCORE_THRESHOLD=0.35
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
